{
  "manifest_version": 3,
  "name": "PaperLens 文獻對照閱讀器",
  "version": "0.1.0",
  "description": "左原文、右繁體中文對照閱讀，圖片與排版原樣保留；螢光筆註解、AI 解釋、雙欄 PDF 匯出。",
  "minimum_chrome_version": "138",

  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "contextMenus"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PaperLens 對照閱讀 (Alt+Shift+T)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "commands": {
    "toggle-split": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "開啟／關閉對照閱讀"
    },
    "highlight-selection": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "螢光標記選取的文字"
    },
    "export-pdf": {
      "description": "匯出雙欄 PDF"
    }
  }
}
